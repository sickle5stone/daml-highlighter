{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Daml",
  "scopeName": "source.daml",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#daml-keywords" },
    { "include": "#daml-actions" },
    { "include": "#data-keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.daml",
          "match": "(--)(\\s*\\|.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.daml" },
            "2": { "name": "comment.line.documentation.daml" }
          }
        },
        {
          "name": "comment.line.double-dash.daml",
          "match": "(--)(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.daml" }
          }
        },
        {
          "name": "comment.block.daml",
          "begin": "\\{-",
          "end": "-\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.daml" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.daml" }
          },
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.daml",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.daml" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.daml" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.daml",
              "match": "\\\\(n|r|t|\\\\|\"|'|0|a|b|f|v|&|\\^[A-Z@\\[\\]\\\\\\^_]|NUL|SOH|STX|ETX|EOT|ENQ|ACK|BEL|BS|HT|LF|VT|FF|CR|SO|SI|DLE|DC1|DC2|DC3|DC4|NAK|SYN|ETB|CAN|EM|SUB|ESC|FS|GS|RS|US|SP|DEL|[0-9]+|o[0-7]+|x[0-9a-fA-F]+)"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.daml",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.hex.daml",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.octal.daml",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.integer.daml",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.daml",
          "match": "\\b(module|where|import|qualified|as|hiding|if|then|else|case|of|do|let|in|return|forall)\\b"
        }
      ]
    },
    "daml-keywords": {
      "patterns": [
        {
          "name": "keyword.other.template.daml",
          "match": "\\b(template|choice|controller|signatory|observer|ensure|with|key|maintainer|agreement|this|self|archive|nonconsuming|preconsuming|postconsuming)\\b"
        }
      ]
    },
    "daml-actions": {
      "patterns": [
        {
          "name": "support.function.daml",
          "match": "\\b(create|createCmd|createAndExerciseCmd|fetch|fetchByKey|lookupByKey|exercise|exerciseCmd|exerciseByKeyCmd|submit|submitMustFail|submitMulti|submitTree|archive|archiveCmd|assertMsg|assert|abort|getTime|setTime|pass|debug|trace|queryContractId|queryContractKey|allocateParty|allocatePartyWithHint|fromSome|fromOptional|optional|script)\\b"
        }
      ]
    },
    "data-keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.daml",
          "match": "\\b(data|type|class|instance|deriving|newtype|interface|exception)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.daml",
          "match": "\\b(Party|Decimal|Text|Bool|Time|Date|Int|Optional|ContractId|Script|Update|Scenario|Either|Map|Set|DA\\.\\w+)\\b"
        },
        {
          "name": "entity.name.type.daml",
          "match": "\\b[A-Z][a-zA-Z0-9_']*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.daml",
          "match": "\\b(True|False|None|Some|Nothing|Just)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.daml",
          "match": "->|<-|=>|→|←|⇒"
        },
        {
          "name": "keyword.operator.comparison.daml",
          "match": "/=|==|<=|>=|<>|<|>"
        },
        {
          "name": "keyword.operator.composition.daml",
          "match": "\\."
        },
        {
          "name": "keyword.operator.bind.daml",
          "match": ">>=|=<<"
        },
        {
          "name": "keyword.operator.functor.daml",
          "match": "<\\$>|<\\*>"
        },
        {
          "name": "keyword.operator.append.daml",
          "match": "\\+\\+|<>"
        },
        {
          "name": "keyword.operator.arithmetic.daml",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.assignment.daml",
          "match": "="
        },
        {
          "name": "keyword.operator.type-annotation.daml",
          "match": "::"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.daml",
          "match": "^([a-z_][a-zA-Z0-9_']*)\\s*(?=::|=)",
          "captures": {
            "1": { "name": "entity.name.function.daml" }
          }
        }
      ]
    }
  }
}
